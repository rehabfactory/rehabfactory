# Environment Variables — Rehab Factory Website
# Copy this file to .env and fill in your credentials

# Port for the Express server
PORT=3000

# Gmail address used to SEND emails (must have 2FA enabled)
EMAIL_USER=your-gmail-address@gmail.com

# Google App Password (16-character code from Google Account > Security > App Passwords)
# DO NOT use your regular Gmail password here
EMAIL_PASS=your-sixteen-char-app-password

# Email address to RECEIVE enquiry notifications
EMAIL_TO=admin@rehabfactory.com.au
